# Kopiere diese Datei zu ".env" und trage deine Werte ein.

# Deine Gmail-Adresse, in der das Label "Presse" liegt
GMAIL_USER=robert.strehler@gmail.com

# App-Passwort (NICHT dein normales Passwort!)
# Google-Konto -> Sicherheit -> Bestätigung in zwei Schritten -> App-Passwörter
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Das Label, das ausgelesen wird
GMAIL_LABEL=Presse

# Wie weit zurück gelesen wird (Stunden). 48 = die letzten zwei Tage.
LOOKBACK_HOURS=48

# KIRA-Bewertung (Sichtung) + Recherche laufen über Anthropic (günstiges Haiku).
ANTHROPIC_API_KEY=
KIRA_MODEL=claude-haiku-4-5-20251001

# Textgenerierung läuft über OpenAI (erzwungenes JSON = zuverlässig, günstig).
# Neuen Key erzeugen: platform.openai.com -> API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
